# This repo holds ONLY the photobooth app (Angular) + its deploy workflow.
# Design sources, the logo archive, exports and OS junk stay local — not in the repo.

# ignore everything in the project root by default...
/*

# ...then keep just the Angular app
!/.gitignore
!/.github
!/README.md
!/angular.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.app.json
!/src
!/public
!/retro

# build output, caches, dependencies
/dist
/.angular
/node_modules

# OS / editor junk
Thumbs.db
.DS_Store
