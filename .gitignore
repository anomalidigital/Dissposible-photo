# This repo = the published photobooth site (repo root, served by GitHub Pages
# straight from the branch — no GitHub Actions) + its Angular source in source/.
# Design sources, the logo archive, exports and OS junk stay local — not in the repo.

# ignore everything in the project root by default...
/*

# ...then keep the site and its source
!/.gitignore
!/.nojekyll
!/.site-files
!/README.md
!/source
!/retro

# the published build (regenerated by `npm run build:site` in source/)
!/index.html
!/favicon.png
!/img
!/main-*.js
!/chunk-*.js
!/polyfills-*.js
!/styles-*.css
!/media

# Angular dependencies, build output and caches
/source/node_modules
/source/dist
/source/.angular

# OS / editor junk
Thumbs.db
.DS_Store
